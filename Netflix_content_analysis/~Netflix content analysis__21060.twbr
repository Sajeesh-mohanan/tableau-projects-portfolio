      <aliases enabled='yes' />
      <column datatype='real' default-format='p0.00%' name='[Calculation1]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([show_id]) / TOTAL(COUNT([show_id]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column datatype='real' default-format='p0.00%' name='[Calculation2]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([show_id]) / TOTAL(COUNT([show_id]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Duration in mins' datatype='integer' name='[Calculation_1085930475327000582]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF CONTAINS([duration], &apos;min&apos;) THEN&#13;&#10;INT(SPLIT([duration],&quot; &quot;,1))&#13;&#10;END' />
      </column>
      <column caption='Avg duration' datatype='real' name='[Calculation_1085930475332706313]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([Calculation_1085930475327000582])' />
      </column>
      <column caption='Genre' datatype='string' name='[Calculation_1125336961098919937]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF CONTAINS([listed_in], &quot;,&quot;) THEN&#13;&#10;    LEFT([listed_in], FIND([listed_in], &quot;,&quot;) - 1)&#13;&#10;ELSE&#13;&#10;    [listed_in]&#13;&#10;END' />
      </column>
      <column caption='Sub-genres' datatype='string' name='[Calculation_1125336961100197890]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF CONTAINS([listed_in], &quot;,&quot;) THEN&#13;&#10;    RIGHT([listed_in], &#13;&#10;          LEN([listed_in]) - &#13;&#10;          FIND([listed_in], &quot;,&quot;, FIND([listed_in], &quot;,&quot;) + 1))&#13;&#10;ELSE&#13;&#10;    [listed_in]&#13;&#10;END' />
      </column>
      <column caption='Text' datatype='string' name='[Calculation_1246089739200688132]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&apos;NETFLIX&apos;' />
      </column>
      <column caption='Text ratings' datatype='string' name='[Calculation_1246089739201208325]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&apos;&apos;' />
      </column>
      <column caption='Delay' datatype='integer' name='[Calculation_1391612299653750785]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='YEAR([date_added]) - [release_year]' />
      </column>
      <column caption='Country 1' datatype='string' name='[Calculation_1774418267244957697]' role='dimension' semantic-role='[Country].[Name]' type='nominal'>
        <calculation class='tableau' formula='SPLIT([country], &quot;,&quot;, 1)' />
      </column>
      <column caption='Country 2' datatype='string' name='[Calculation_1774418267310219280]' role='dimension' semantic-role='[Country].[Name]' type='nominal'>
