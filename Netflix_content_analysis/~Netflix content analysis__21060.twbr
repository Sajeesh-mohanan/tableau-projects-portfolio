      <column caption='Genre' datatype='string' name='[Calculation_1125336961098919937]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF CONTAINS([listed_in], &quot;,&quot;) THEN&#13;&#10;    LEFT([listed_in], FIND([listed_in], &quot;,&quot;) - 1)&#13;&#10;ELSE&#13;&#10;    [listed_in]&#13;&#10;END' />
      </column>
      <column caption='Sub-genres' datatype='string' name='[Calculation_1125336961100197890]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF CONTAINS([listed_in], &quot;,&quot;) THEN&#13;&#10;    RIGHT([listed_in], &#13;&#10;          LEN([listed_in]) - &#13;&#10;          FIND([listed_in], &quot;,&quot;, FIND([listed_in], &quot;,&quot;) + 1))&#13;&#10;ELSE&#13;&#10;    [listed_in]&#13;&#10;END' />
      </column>
