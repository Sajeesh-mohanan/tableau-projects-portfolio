  <worksheets>
    <worksheet name=' Directors work in multiple genres'>
      <repository-location derived-from='https://public.tableau.com/workbooks/Netflixcontentanalysis_17489707360360/117518638?rev=' id='Directorsworkinmultiplegenres' path='/workbooks/Netflixcontentanalysis_17489707360360' revision='' />
      <table>
        <view>
          <datasources>
            <datasource caption='netflix_titles (netflix_titles)' name='federated.0qtherb0uk6bov19vvaw70l7kr9a' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column alias='All' caption='Type parameter' datatype='string' name='[Parameter 3]' param-domain-type='list' role='measure' type='nominal' value='&quot;All&quot;'>
              <calculation class='tableau' formula='&quot;All&quot;' />
              <aliases>
                <alias key='&quot;All&quot;' value='All' />
                <alias key='&quot;Movie&quot;' value='Movie' />
                <alias key='&quot;TV show&quot;' value='TV Shows' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.0qtherb0uk6bov19vvaw70l7kr9a'>
            <column caption='Genre' datatype='string' name='[Calculation_1125336961098919937]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF CONTAINS([listed_in], &quot;,&quot;) THEN&#13;&#10;    LEFT([listed_in], FIND([listed_in], &quot;,&quot;) - 1)&#13;&#10;ELSE&#13;&#10;    [listed_in]&#13;&#10;END' />
            </column>
            <column-instance column='[Calculation_1125336961098919937]' derivation='CountD' name='[ctd:Calculation_1125336961098919937:qk]' pivot='key' type='quantitative' />
            <column caption='Director' datatype='string' name='[director]' role='dimension' type='nominal' />
            <column caption='Listed In' datatype='string' name='[listed_in]' role='dimension' type='nominal' />
            <column-instance column='[director]' derivation='None' name='[none:director:nk]' pivot='key' type='nominal' />
            <column-instance column='[type]' derivation='None' name='[none:type:nk]' pivot='key' type='nominal' />
            <column caption='Show Id' datatype='string' name='[show_id]' role='dimension' type='nominal' />
            <column caption='Type' datatype='string' name='[type]' role='dimension' type='nominal' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.0qtherb0uk6bov19vvaw70l7kr9a].[Action (Director,Type)]'>
            <groupfilter function='crossjoin' user:ui-action-filter='[Action12_2A68C2C61B7B45F8A6AD819D2CACF129]' user:ui-enumeration='all' user:ui-marker='enumerate'>
              <groupfilter function='level-members' level='[director]' />
              <groupfilter function='level-members' level='[type]' />
            </groupfilter>
          </filter>
          <filter class='quantitative' column='[federated.0qtherb0uk6bov19vvaw70l7kr9a].[ctd:Calculation_1125336961098919937:qk]' included-values='in-range'>
